Include Ensemble

/// Base class of every custom BPL activity.
/// <p>
/// A custom activity is one class: a subclass of this one. Its properties are the
/// activity's parameters, its <method>Execute</method> method is what the activity
/// does, and its class parameters say how the Business Process Designer shows it.
/// Compile a subclass and it appears in the designer's <b>Add Activity</b> menu
/// under <i>Custom activities</i>, with an input field per property in the
/// Activity tab. Nothing has to be registered anywhere.
/// <p>
/// The activity runs inside the business process itself: in the BPL it is a
/// &lt;code&gt; activity, generated by the designer, that creates the activity,
/// sets its parameters, calls <method>Run</method> and stores the results in the
/// context. No message is sent and no production item is needed.
/// <p>
/// Property rules the designer follows:
/// <ul>
/// <li>The property's description is shown as help under its input field.</li>
/// <li><code>[ Required ]</code> marks the field as required. The parameters are
/// validated before the activity runs, so a missing value fails it.</li>
/// <li><code>InitialExpression</code> is filled in as the value when the activity
/// is added. Values are ObjectScript expressions, so a literal needs quotes.</li>
/// <li><code>VALUELIST</code> is offered as suggestions in the field, and checked
/// before the activity runs.</li>
/// <li>A default that refers to the process, such as
/// <code>context.%LastError</code>, cannot be an InitialExpression (that runs
/// when the object is created). Put it in an XData block
/// <code>ActivityDefaults</code> holding a JSON object of property name to
/// expression; the designer fills it in instead.</li>
/// </ul>
Class app.bplplus.activity Extends %RegisteredObject [ Abstract ]
{

/// Caption of the activity in the Add Activity menu and on the shape in the
/// diagram, for example "Send notification". Empty means the class name.
Parameter ACTIVITYCAPTION As STRING;

/// Result class of the activity. It has to be app.bplplus.activityResult or a
/// subclass; its properties are offered in the designer as results that are
/// stored in the process context.
Parameter ACTIVITYRESULT As STRING = "app.bplplus.activityResult";

/// 1 stores every result in a context property of its own when the activity is
/// added in the designer (named after the activity and the result, such as
/// context.ValidateValueSuccess, and created if needed); 0 leaves results
/// unstored until the process designer names a property.
Parameter ACTIVITYAUTOMAP As BOOLEAN = 1;

/// 0 leaves the class out of the designers' menu: for a class that runs
/// activities rather than being one, such as app.bplplus.python.step.
Parameter ACTIVITYLISTED As BOOLEAN = 1;

/// Fill colour of the activity's shape in the diagram, as a CSS colour, so custom
/// activities stand out from the built-in ones.
Parameter ACTIVITYCOLOR As STRING = "#FFF3D6";

/// Does the activity's work. <var>pProcess</var> is the business process the
/// activity runs in, so the activity can log, read the process's settings or
/// send requests of its own.
/// <p>
/// Return an error status when the activity could not run: the process then
/// raises a fault, which a catchall can handle. An outcome that is merely
/// negative (a value that does not validate) is a normal result: return $$$OK and
/// set <property>Success</property> of the result to 0.
Method Execute(pProcess As Ens.BusinessProcess, Output pResult As app.bplplus.activityResult) As %Status [ Abstract ]
{
}

/// What the generated BPL code calls: validates the parameters (required ones and
/// value lists), runs <method>Execute</method> and makes sure there is a result
/// object to read. An activity that throws instead of returning a status fails
/// with an error naming the activity, as does an invalid parameter.
Method Run(pProcess As Ens.BusinessProcess, Output pResult As app.bplplus.activityResult) As %Status [ Final ]
{
	Set pResult = ""
	Set tCaption = $Parameter($this, "ACTIVITYCAPTION")
	If tCaption = "" Set tCaption = $ClassName($this)
	Set tSC = ..%ValidateObject()
	If $$$ISERR(tSC) {
		Quit $$$ADDSC($$$ERROR($$$GeneralError, "Activity "_tCaption_" has an invalid parameter"), tSC)
	}
	Try {
		Set tSC = ..Execute(pProcess, .pResult)
	}
	Catch ex {
		Set tSC = $$$ERROR($$$GeneralError, "Activity "_tCaption_" failed: "_ex.DisplayString())
	}
	If $$$ISOK(tSC) && '$IsObject($Get(pResult)) {
		Set pResult = $ClassMethod($Parameter($this, "ACTIVITYRESULT"), "%New")
	}
	Quit tSC
}

}
